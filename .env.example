# 이 파일을 .env 로 복사한 뒤 값을 채운다.  .env 는 커밋하지 않는다(.gitignore 처리됨).
#   cp .env.example .env          (Windows PowerShell:  copy .env.example .env)
#
# 값은 DDBM 사이트 → 내 팀 정보 / 서버 연계 에서 확인한다.
# 아무것도 안 채워도 된다 — DB 접속이 없으면 자동으로 로컬 CSV 를 쓴다(계산식 동일).

# --- 팀 MariaDB (선택) ---
DB_HOST=
DB_PORT=
DB_USER=
DB_NAME=
DB_PASSWORD=

# --- 라이엇 API (선택, "내 경기 불러오기" 기능에만 필요) ---
# developer.riotgames.com 에서 발급. 24시간마다 갱신된다.
RIOT_API_KEY=

# --- 서비스 포트 (기본값 그대로 두면 된다) ---
# FRONTEND_PORT=9504
# BACKEND_PORT=9524
